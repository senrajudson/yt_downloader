{
  "manifest_version": 3,
  "name": "Universal Video Downloader",
  "version": "1.5",
  "permissions": ["cookies", "activeTab", "tabs", "scripting", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}